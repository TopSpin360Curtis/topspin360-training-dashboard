GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# Preferred multi-tenant auth + dataset mapping:
# Each account is locked to one dataset and one login route.
# Example usernames:
# - lions_staff can only log in at /login/team
# - demo_test can only log in at /login/test
DASHBOARD_TENANTS_JSON='[
  {
    "id": "lions",
    "label": "Detroit Lions",
    "username": "lions_staff",
    "password": "replace_me",
    "profile": "team",
    "sheetId": "your_team_sheet_id",
    "range": "Clean!A:Z"
  },
  {
    "id": "test-demo",
    "label": "Test Data",
    "username": "demo_test",
    "password": "replace_me",
    "profile": "test",
    "sheetId": "your_test_sheet_id",
    "range": "Clean!A:Z"
  }
]'

# Legacy shared-password fallback. Only use if you are not ready for tenant logins yet.
# DASHBOARD_ACCESS_PASSWORD=choose_a_shared_dashboard_password
# GOOGLE_SHEET_ID=your_private_google_sheet_id
# GOOGLE_SHEET_RANGE=Clean!A:Z
# TEST_GOOGLE_SHEET_ID=your_test_google_sheet_id
# TEST_GOOGLE_SHEET_RANGE=Sheet1!A:Z

# Optional public-sheet fallback:
# NEXT_PUBLIC_SHEET_ID=your_public_sheet_id
# NEXT_PUBLIC_TEST_SHEET_ID=your_public_test_sheet_id
# GOOGLE_API_KEY=your_google_api_key
# TEST_GOOGLE_API_KEY=your_google_api_key
